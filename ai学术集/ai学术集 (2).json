    {
      "parameters": {
        "jsCode": "// 获取来自上一个 AI 节点的所有输入数据\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n    try {\n        // 提取 AI 生成的那个脏脏的字符串 (注意：根据你的截图，字段名是 output)\n        const aiString = item.json.output; \n        \n        // 核心魔法：把字符串一键解析成真正的 JSON 对象\n        const cleanData = JSON.parse(aiString);\n        \n        // 组装成 n8n 标准的数据格式并输出\n        results.push({\n            json: cleanData\n        });\n        \n    } catch (error) {\n        // 容错机制：如果 AI 某次发疯没输出标准 JSON，防止整个工作流崩溃\n        results.push({\n            json: {\n                error: \"解析失败，AI 未输出标准 JSON\",\n                raw_data: item.json\n            }\n        });\n    }\n}\n\n// 返回清洗后整齐的数据\nreturn results;"
      },
