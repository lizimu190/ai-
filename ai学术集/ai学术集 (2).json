      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (let item of items) {\n    // 检查是不是传了文件过来\n    if (item.json.body && item.json.body.content) {\n        const base64String = item.json.body.content;\n        const mimeType = item.json.body.mimeType || 'application/octet-stream';\n        const fileName = item.json.body.fileName || 'upload_file';\n\n        // 将 Base64 挂载到 n8n 的专属二进制字段 (binary) 上\n        item.binary = {\n            data: {\n                data: base64String,\n                mimeType: mimeType,\n                fileName: fileName\n            }\n        };\n    }\n}\nreturn items;"
      },
