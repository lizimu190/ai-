    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n    // 1. 获取原始脏文本 (⚠️注意：把 ai_output 换成你上一步输出的字段名)\n    let rawStr = item.json.output || \"\"; \n    if (typeof rawStr !== 'string') rawStr = JSON.stringify(rawStr);\n\n    // 暴力定义默认值\n    let title = \"未提取到标题\";\n    let summary = \"未提取到摘要\";\n    let tags = [];\n    let category = \"学术\";\n\n    try {\n        // ⚔️ 暴力拆解 1：提标题 (找 title/标题 冒号后面的字，遇到逗号或换行就停)\n        let titleMatch = rawStr.match(/(?:title|标题)[”\"]?\\s*[：:]\\s*[“\"]?([^”\",，\\n]+)/i);\n        if (titleMatch) title = titleMatch[1].trim();\n\n        // ⚔️ 暴力拆解 2：提类别 (找 category/类别 冒号后面的字)\n        let categoryMatch = rawStr.match(/(?:category|类别)[”\"]?\\s*[：:]\\s*[“\"]?([^”\"\\}\\n]+)/i);\n        if (categoryMatch) category = categoryMatch[1].trim();\n\n        // ⚔️ 暴力拆解 3：提标签 (直接把方括号 [...] 里的内容全挖出来)\n        let tagsMatch = rawStr.match(/\\[([\\s\\S]*?)\\]/);\n        if (tagsMatch) {\n            // 把里面乱七八糟的引号、换行全去掉，按逗号切成数组\n            tags = tagsMatch[1].split(/[,，\\n]/)\n                .map(t => t.replace(/[\"“”]/g, '').trim())\n                .filter(t => t.length > 0);\n        }\n\n        // ⚔️ 暴力拆解 4：提摘要 (最难搞的一个)\n        // 逻辑：找到 summary/摘要，然后一直往后切，直到撞见 tags 或 category 关键词才停！无视中间的所有引号！\n        let summaryRegex = /(?:summary|摘要)[”\"]?\\s*[：:]\\s*[“\"]?([\\s\\S]*?)(?=[”\"]?\\s*[,，]?\\s*[”\"]?(?:tags|标签|category|类别))/i;\n        let summaryMatch = rawStr.match(summaryRegex);\n        if (summaryMatch) {\n            let tempSummary = summaryMatch[1];\n            // 把末尾不小心切进来的多余引号或逗号擦干净\n            summary = tempSummary.replace(/[”\",，\\s]*$/, '').trim();\n        }\n\n        // 组装出完美的干净数据\n        results.push({\n            json: {\n                title: title,\n                summary: summary,\n                tags: tags,\n                category: category\n            }\n        });\n\n    } catch (error) {\n        // 就算天塌下来，也要输出点东西，不让工作流卡死\n        results.push({\n            json: {\n                error: \"暴力拆解失败\",\n                raw_string: rawStr\n            }\n        });\n    }\n}\n\nreturn results;"
      },
